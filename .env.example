# Kopyalayın: .env  →  flutter run --dart-define-from-file=.env
# .env dosyası .gitignore ile hariç tutulur; gerçek anahtarları ASLA commit etmeyin.

# Google Gemini API (zorunlu değil — yoksa öğünler elle eklenir)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Supabase (yorum satırı olarak kalırsa varsayılan proje kullanılır)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key_here
